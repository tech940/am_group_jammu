# Copy to .env for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables.
#
# .env* is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Inventory source (REQUIRED once this app serves amgroupind.com)
# ---------------------------------------------------------------------------
# Origin of the WordPress site the vehicle inventory is read from, and which
# also serves every vehicle photograph.
#
# While WordPress still owns amgroupind.com you can leave this unset. The
# moment DNS points amgroupind.com at Vercel you MUST set it to wherever
# WordPress has moved, or the sync will request inventory from this app
# itself, find no Motors markup, and the site will render zero cars.
#
# MOTORS_BASE_URL=https://legacy.amgroupind.com

# Optional shared secret enabling the ?fresh=1 cache bypass on
# /api/inventory/used. Without it the bypass is simply unavailable.
# MOTORS_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Admin area (REQUIRED)
# ---------------------------------------------------------------------------
# /admin exposes every lead's name, phone and email. Use a long random value —
# NOT the local development password.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; rotating it logs
# everyone out. Generate with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase — lead storage (REQUIRED in production)
# ---------------------------------------------------------------------------
# Without these, leads fall back to a local file store, which does not persist
# on Vercel: every deploy discards them.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Tag Manager container, e.g. GTM-XXXXXXX. GTM does not load at all
# while this is empty.
NEXT_PUBLIC_GTM_ID=

# Load GTM in development too. Off by default so local traffic does not
# pollute production analytics.
# NEXT_PUBLIC_GTM_DEV=true

# ---------------------------------------------------------------------------
# Contact
# ---------------------------------------------------------------------------
# WhatsApp number in digits only, with country code and no "+". Must be a
# number actually registered on WhatsApp, or every WhatsApp button opens a
# dead "phone number shared via url is invalid" screen. Defaults to the
# primary showroom number in lib/locations.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919419100000
